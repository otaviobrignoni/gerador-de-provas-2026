@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Questões";
}

@model List<ListarQuestaoViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Nova</a>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Nenhuma questão cadastrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-2">
        @foreach (ListarQuestaoViewModel q in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <h5 class="card-title mb-0">@q.Enunciado</h5>
                            <span class="badge text-bg-primary rounded-pill">@q.Id.ToString().Substring(0, 8)</span>
                        </div>

                        <dl class="row g-2 mb-4">
                            <dt class="col-sm-4 text-secondary fw-semibold">ID</dt>
                            <dd class="col-sm-8 mb-0 text-break">@q.Id</dd>

                            <dt class="col-sm-4 text-secondary fw-semibold">Matéria</dt>
                            <dd class="col-sm-8 mb-0">@q.NomeMateria</dd>

                            <dt class="col-sm-4 text-secondary fw-semibold">Resposta correta</dt>
                            <dd class="col-sm-8 mb-0">@q.RespostaCorreta</dd>
                        </dl>

                        <div class="d-flex flex-wrap gap-2 mt-auto justify-content-end">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Editar" asp-route-id="@q.Id">Editar</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Excluir" asp-route-id="@q.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
