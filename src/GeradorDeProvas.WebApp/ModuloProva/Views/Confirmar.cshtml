@{
    Layout = "_Layout";
    ViewBag.Titulo = "Geração de Prova - Etapa 3";
}

@model ConfirmarProvaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 900px;" asp-action="Confirmar" method="post">
    <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>
    <h5 class="text-primary mb-3">Confirmação</h5>
    <p class="text-secondary small">Confira os dados e as questões sorteadas antes de confirmar a geração.</p>

    <dl class="row g-2 mb-4">
        <dt class="col-sm-4 text-secondary fw-semibold">Título</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Disciplina</dt>
        <dd class="col-sm-8">@Model.NomeDisciplina</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Matéria</dt>
        <dd class="col-sm-8">@(Model.ProvaRecuperacao ? "Prova de recuperação" : Model.NomeMateria)</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Série</dt>
        <dd class="col-sm-8">@Model.Serie</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Quantidade</dt>
        <dd class="col-sm-8">@Model.QuantidadeQuestoes</dd>
    </dl>

    <h6 class="text-primary mb-3">Questões sorteadas</h6>
    @for (int indice = 0; indice < Model.Questoes.Count; indice++)
    {
        QuestaoProvaViewModel questao = Model.Questoes[indice];
        <div class="border rounded-3 p-3 mb-3">
            <p class="fw-semibold mb-2">@(indice + 1). @questao.Enunciado</p>
            <ul class="mb-0">
                @foreach (AlternativaProvaViewModel alternativa in questao.Alternativas)
                {
                    <li>@alternativa.Texto</li>
                }
            </ul>
        </div>
    }

    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="SelecionarQuestoes">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar geração</button>
    </div>
</form>
