@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Prova";
}

@model DetalhesProvaViewModel

<div class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 900px;">
    <dl class="row g-2 mb-4">
        <dt class="col-sm-4 text-secondary fw-semibold">ID</dt>
        <dd class="col-sm-8 text-break">@Model.Id</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Título</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Disciplina</dt>
        <dd class="col-sm-8">@Model.NomeDisciplina</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Matéria</dt>
        <dd class="col-sm-8">@(Model.ProvaRecuperacao ? "Prova de recuperação" : Model.NomeMateria)</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Série</dt>
        <dd class="col-sm-8">@Model.Serie</dd>
    </dl>

    <h5 class="text-primary mb-3">Questões</h5>
    @for (int indice = 0; indice < Model.Questoes.Count; indice++)
    {
        QuestaoProvaViewModel questao = Model.Questoes[indice];
        <div class="border rounded-3 p-3 mb-3">
            <p class="fw-semibold mb-2">@(indice + 1). @questao.Enunciado</p>
            <ul class="mb-0">
                @foreach (AlternativaProvaViewModel alternativa in questao.Alternativas)
                {
                    <li>@alternativa.Texto</li>
                }
            </ul>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-end gap-2">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Pdf" asp-route-id="@Model.Id">Baixar prova</a>
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Gabarito" asp-route-id="@Model.Id">Baixar gabarito</a>
        <a class="btn btn-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
    </div>
</div>
