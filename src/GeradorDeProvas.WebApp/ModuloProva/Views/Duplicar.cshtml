@{
    Layout = "_Layout";
    ViewBag.Titulo = "Duplicação de Prova";
}

@model DuplicarProvaViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 780px;" asp-action="Duplicar" method="post">
    <input asp-for="Id" type="hidden">
    <input asp-for="NomeDisciplina" type="hidden">
    <input asp-for="NomeMateria" type="hidden">
    <input asp-for="Serie" type="hidden">
    <input asp-for="QuantidadeQuestoes" type="hidden">
    <input asp-for="ProvaRecuperacao" type="hidden">
    <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>
    <div class="alert alert-primary border-start border-primary border-4 rounded-3">As questões serão deixadas em branco para uma nova geração.</div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Novo título</label>
        <input asp-for="Titulo" class="form-control">
        <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
    </div>
    <dl class="row mb-0">
        <dt class="col-sm-5 text-secondary fw-semibold">Disciplina</dt>
        <dd class="col-sm-7">@Model.NomeDisciplina</dd>
        <dt class="col-sm-5 text-secondary fw-semibold">Matéria</dt>
        <dd class="col-sm-7">@(Model.ProvaRecuperacao ? "Prova de recuperação" : Model.NomeMateria)</dd>
        <dt class="col-sm-5 text-secondary fw-semibold">Série</dt>
        <dd class="col-sm-7">@Model.Serie</dd>
        <dt class="col-sm-5 text-secondary fw-semibold">Quantidade</dt>
        <dd class="col-sm-7">@Model.QuantidadeQuestoes</dd>
    </dl>
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Duplicar</button>
    </div>
</form>
