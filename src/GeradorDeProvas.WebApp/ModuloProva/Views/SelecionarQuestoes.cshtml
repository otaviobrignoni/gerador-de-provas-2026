@{
    Layout = "_Layout";
    ViewBag.Titulo = "Geração de Prova - Etapa 2";
}

@model CadastrarProvaEtapa2ViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 780px;" asp-action="SelecionarQuestoes" method="post">
    <input asp-for="Titulo" type="hidden">
    <input asp-for="NomeDisciplina" type="hidden">
    <input asp-for="Serie" type="hidden">
    <input asp-for="ProvaRecuperacao" type="hidden">
    <div asp-validation-summary="All" class="text-danger small fw-semibold mb-3"></div>

    <h5 class="text-primary mb-3">Matéria e sorteio</h5>
    <dl class="row g-2 mb-4">
        <dt class="col-sm-4 text-secondary fw-semibold">Título</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Disciplina</dt>
        <dd class="col-sm-8">@Model.NomeDisciplina</dd>
        <dt class="col-sm-4 text-secondary fw-semibold">Série</dt>
        <dd class="col-sm-8">@Model.Serie</dd>
    </dl>

    @if (Model.ProvaRecuperacao)
    {
        <div class="alert alert-primary border-start border-primary border-4 rounded-3">
            Esta é uma prova de recuperação. O sorteio considerará todas as matérias da disciplina.
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="MateriaId" class="form-label fw-semibold text-primary text-uppercase small">Matéria</label>
            <select asp-for="MateriaId" asp-items="ViewBag.Materias" class="form-select">
                <option value="">Selecione uma matéria</option>
            </select>
            <span asp-validation-for="MateriaId" class="text-danger small fw-semibold"></span>
        </div>
    }

    <div class="mb-4">
        <label asp-for="QuantidadeQuestoes" class="form-label fw-semibold text-primary text-uppercase small">Quantidade de questões para sortear</label>
        <input asp-for="QuantidadeQuestoes" class="form-control" type="number" min="1">
        <span asp-validation-for="QuantidadeQuestoes" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Cadastrar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Sortear questões</button>
    </div>
</form>
